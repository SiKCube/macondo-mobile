{
  "expo": {
    "name": "macondo-mobile",
    "slug": "macondo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mm-icon.png",
    "scheme": "macondomobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#c4d86c",
        "foregroundImage": "./assets/images/mm-fg.png",
        "backgroundImage": "./assets/images/mm-bg.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sikcube.macondomobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/mm-icon-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#eAcfb3",
          "dark": {
            "backgroundColor": "#eAcfb3"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "740bc2b1-3ad1-441e-9cd9-b8ded102af2c"
      }
    }
  }
}
